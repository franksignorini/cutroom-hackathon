# Stripe Projects writes most credentials to .env automatically (`stripe projects add ...`).

# --- CreateOS Sandbox ---
CREATEOS_PROJECT_API_KEY=            # written by `stripe projects add createos/project`
CREATEOS_SANDBOX_API_KEY=            # optional, wins over the project key
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh
CREATEOS_SANDBOX_ID=                 # warm sandbox id, printed by web/scripts/setup-sandbox.mjs
CREATEOS_SHAPE=s-1vcpu-1gb
CREATEOS_REGION=
CREATEOS_MOCK=off                    # on = use the local mock of the CreateOS API

# --- Pipeline ---
PIPELINE=simulate                    # simulate | local | live
OPENROUTER_API_KEY=                  # written by `stripe projects add openrouter/api`
MODELS_FREE=
MODELS_PREMIUM=
GROQ_API_KEY=                        # optional fallback
GOOGLE_API_KEY=                      # optional fallback
CUTROOM_URL=                         # public URL of the app, used by the sandbox for heartbeat/done

# --- Jobs and limits ---
MAX_RUNNING=1
MAX_QUEUE=3
PER_IP_LIMIT=1

# --- Stripe (test mode only) ---
PAYMENTS=off
PREMIUM=off
STRIPE_SECRET_KEY=                   # sk_test_...
STRIPE_PUBLISHABLE_KEY=              # pk_test_...
STRIPE_WEBHOOK_SECRET=               # whsec_...
TRAILER_PRICE_CENTS=

# --- Storage ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDINARY_URL=
